# =============================================================================
# Educa Mais - variaveis de ambiente para desenvolvimento local.
# Copie para .env (ignorado pelo Git) e preencha apenas o que for usar.
# =============================================================================

# ---------------------------------------------------------------- aplicacao
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080

# ------------------------------------------------------------------ banco
DB_URL=jdbc:postgresql://postgres:5432/educamais
DB_USER=educamais
DB_PASSWORD=educamais

# -------------------------------------------------------------- seguranca
# >= 32 caracteres. Em producao, gere com: openssl rand -base64 48
JWT_SECRET=dev-secret-com-pelo-menos-32-caracteres!!
# Chave AES-256 (32 bytes em hex ou base64). Em producao: AWS Secrets Manager/KMS
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
CORS_ALLOWED_ORIGINS=http://localhost:4200
SCHOOL_API_KEY=dev-school-api-key
SCHOOL_HMAC_SECRET=dev-school-hmac-secret

# ------------------------------------------------------------------ Gemini
# Sem estas variaveis o agente funciona com plano deterministico (FALLBACK)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- WhatsApp
# DEMO | TWILIO | EVOLUTION
WHATSAPP_PROVIDER=DEMO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ------------------------------------------------------------------ Authelia
AUTHELIA_ENABLED=false
AUTHELIA_ISSUER_URI=https://auth.educa-mais.local
AUTHELIA_CLIENT_ID=educa-mais
AUTHELIA_CLIENT_SECRET=troque-em-producao
AUTHELIA_SESSION_SECRET=dev-authelia-session-secret-32-chars
AUTHELIA_STORAGE_KEY=dev-authelia-storage-key-32-chars
AUTHELIA_OIDC_HMAC=dev-authelia-oidc-hmac-32-caracteres

# ------------------------------------------------------------------ agente
AGENT_MAX_STEPS=5
AGENT_MAX_ATTEMPTS_STEP=3

# --------------------------------------------------------- observabilidade
GRAFANA_PASSWORD=admin
